
#include <gz/sim/System.hh>
#include <gz/sim/Model.hh>
#include <gz/sim/Link.hh>
#include <gz/sim/components/Name.hh>
#include <gz/sim/components/Pose.hh>
#include <gz/sim/components/LinearVelocity.hh>
#include <gz/plugin/Register.hh>

#include <algorithm>
#include <string>

namespace chocolate_conveyor
{
class ConveyorSystem :
  public gz::sim::System,
  public gz::sim::ISystemPreUpdate
{
public:
  void PreUpdate(
    const gz::sim::UpdateInfo &_info,
    gz::sim::EntityComponentManager &_ecm) override
  {
    if (_info.paused)
      return;

    // Høyre transportbånd: x = 1, y = -2
    constexpr double beltX = 1.0;
    constexpr double beltY = -2.0;
    constexpr double beltZ = 0.75;
    constexpr double beltLength = 4.90;
    constexpr double beltWidth = 0.38;
    constexpr double speed = 0.15;

    _ecm.Each<gz::sim::components::Name,
              gz::sim::components::Pose>(
      [&](const gz::sim::Entity &_entity,
          const gz::sim::components::Name *_name,
          const gz::sim::components::Pose *_pose) -> bool
      {
        if (_name->Data().find("chocolate_bar") == std::string::npos)
          return true;

        const auto &position = _pose->Data().Pos();

        // Kun sjokoladeplater på høyre transportbånd.
        if (std::abs(position.X() - beltX) > beltWidth / 2.0 ||
            std::abs(position.Y() - beltY) > beltLength / 2.0 ||
            position.Z() < beltZ ||
            position.Z() > beltZ + 0.15)
          return true;

        gz::sim::Model model(_entity);
        auto link = model.CanonicalLink(_ecm);

        if (link.Valid(_ecm))
        {
          // Transportretning langs positiv Y.
          link.SetLinearVelocity(_ecm, gz::math::Vector3d(0, speed, 0));
        }

        return true;
      });
  }
};
}

GZ_ADD_PLUGIN(
  chocolate_conveyor::ConveyorSystem,
  gz::sim::System,
  chocolate_conveyor::ConveyorSystem::ISystemPreUpdate
)
